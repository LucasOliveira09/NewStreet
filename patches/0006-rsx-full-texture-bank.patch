diff --git a/libs/video/rsx_d3d12_texture_slots.h b/libs/video/rsx_d3d12_texture_slots.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_d3d12_texture_slots.h
@@ -0,0 +1,30 @@
+/* Shader-visible D3D12 descriptor layout for the RSX texture units. */
+#ifndef PS3RECOMP_RSX_D3D12_TEXTURE_SLOTS_H
+#define PS3RECOMP_RSX_D3D12_TEXTURE_SLOTS_H
+
+#include <stdint.h>
+#include "rsx_commands.h"
+
+#define RSX_D3D12_FRAME_BANKS 2u
+#define RSX_D3D12_MAX_DRAWS 2048u
+#define RSX_D3D12_TEXTURE_UNITS RSX_MAX_TEXTURES
+#define RSX_D3D12_ATLAS_SRV 0u
+#define RSX_D3D12_VP_SRV_BASE 1u
+#define RSX_D3D12_VP_TEX_SLOTS 96u
+#define RSX_D3D12_RT_SRV_BASE (RSX_D3D12_VP_SRV_BASE + RSX_D3D12_VP_TEX_SLOTS)
+#define RSX_D3D12_MAX_OFF_RTS 16u
+#define RSX_D3D12_DRAW_SRV_BASE (RSX_D3D12_RT_SRV_BASE + RSX_D3D12_MAX_OFF_RTS)
+#define RSX_D3D12_SRV_HEAP_SIZE \
+    (RSX_D3D12_DRAW_SRV_BASE + RSX_D3D12_FRAME_BANKS * \
+     RSX_D3D12_MAX_DRAWS * RSX_D3D12_TEXTURE_UNITS)
+
+static inline u32 rsx_d3d12_draw_srv_slot(u32 frame, u32 draw, u32 unit)
+{
+    if (frame >= RSX_D3D12_FRAME_BANKS || draw >= RSX_D3D12_MAX_DRAWS ||
+        unit >= RSX_D3D12_TEXTURE_UNITS)
+        return UINT32_MAX;
+    return RSX_D3D12_DRAW_SRV_BASE +
+           (frame * RSX_D3D12_MAX_DRAWS + draw) * RSX_D3D12_TEXTURE_UNITS + unit;
+}
+
+#endif
diff --git a/tests/test_d3d12_texture_slots.c b/tests/test_d3d12_texture_slots.c
new file mode 100644
--- /dev/null
+++ b/tests/test_d3d12_texture_slots.c
@@ -0,0 +1,56 @@
+/* Descriptor ownership is CPU-only; no Windows, D3D12, runtime or GPU. */
+#include "rsx_d3d12_texture_slots.h"
+#include <stdint.h>
+#include <stdio.h>
+
+#define CHECK(expr) do { if (!(expr)) { \
+    fprintf(stderr, "line %d: %s\n", __LINE__, #expr); return 1; \
+} } while (0)
+
+static u8 owners[RSX_D3D12_SRV_HEAP_SIZE];
+
+int main(void)
+{
+    CHECK(RSX_D3D12_TEXTURE_UNITS == RSX_MAX_TEXTURES);
+    CHECK(RSX_D3D12_FRAME_BANKS == 2u && RSX_D3D12_MAX_DRAWS == 2048u);
+    CHECK(RSX_D3D12_TEXTURE_UNITS == 16u);
+    CHECK(RSX_D3D12_ATLAS_SRV == 0u);
+    CHECK(RSX_D3D12_VP_SRV_BASE == 1u && RSX_D3D12_VP_TEX_SLOTS == 96u);
+    CHECK(RSX_D3D12_RT_SRV_BASE == 97u && RSX_D3D12_MAX_OFF_RTS == 16u);
+    CHECK(RSX_D3D12_DRAW_SRV_BASE == 113u);
+    CHECK(RSX_D3D12_SRV_HEAP_SIZE == 65649u);
+    owners[RSX_D3D12_ATLAS_SRV] = 1;
+    for (u32 texture = 0; texture < RSX_D3D12_VP_TEX_SLOTS; ++texture) {
+        const u32 slot = RSX_D3D12_VP_SRV_BASE + texture;
+        CHECK(slot < sizeof owners && owners[slot] == 0);
+        owners[slot] = 2;
+    }
+    for (u32 rt = 0; rt < RSX_D3D12_MAX_OFF_RTS; ++rt) {
+        const u32 slot = RSX_D3D12_RT_SRV_BASE + rt;
+        CHECK(slot < sizeof owners && owners[slot] == 0);
+        owners[slot] = 3;
+    }
+    for (u32 frame = 0; frame < RSX_D3D12_FRAME_BANKS; ++frame)
+        for (u32 draw = 0; draw < RSX_D3D12_MAX_DRAWS; ++draw)
+            for (u32 unit = 0; unit < RSX_D3D12_TEXTURE_UNITS; ++unit) {
+                const u32 slot = rsx_d3d12_draw_srv_slot(frame, draw, unit);
+                CHECK(slot >= 113u && slot < sizeof owners);
+                CHECK(owners[slot] == 0); /* Includes both banks and every draw. */
+                owners[slot] = (u8)(4 + frame);
+                if (unit) CHECK(slot == rsx_d3d12_draw_srv_slot(frame, draw, unit - 1) + 1);
+            }
+    for (u32 slot = 0; slot < sizeof owners; ++slot) CHECK(owners[slot] != 0);
+    CHECK(rsx_d3d12_draw_srv_slot(0, 0, 4) == 117u);
+    CHECK(rsx_d3d12_draw_srv_slot(0, 0, 15) == 128u);
+    CHECK(rsx_d3d12_draw_srv_slot(1, 0, 0) == 32881u);
+    CHECK(rsx_d3d12_draw_srv_slot(1, 2047, 15) == RSX_D3D12_SRV_HEAP_SIZE - 1);
+    CHECK(rsx_d3d12_draw_srv_slot(0, 0, 16) == UINT32_MAX);
+    CHECK(rsx_d3d12_draw_srv_slot(2, 0, 0) == UINT32_MAX);
+    CHECK(rsx_d3d12_draw_srv_slot(0, 2048, 0) == UINT32_MAX);
+    CHECK(rsx_d3d12_draw_srv_slot(UINT32_MAX, 0, 0) == UINT32_MAX);
+    CHECK(rsx_d3d12_draw_srv_slot(0, UINT32_MAX, 0) == UINT32_MAX);
+    CHECK(rsx_d3d12_draw_srv_slot(0, 0, UINT32_MAX) == UINT32_MAX);
+    CHECK(rsx_d3d12_draw_srv_slot(UINT32_MAX, UINT32_MAX, UINT32_MAX) == UINT32_MAX);
+    puts("D3D12 texture descriptor ownership: passed");
+    return 0;
+}
