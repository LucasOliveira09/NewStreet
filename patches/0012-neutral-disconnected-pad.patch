     pad_poll_sdl2();
     assert(s_sdl_controllers[0] == NULL && s_rumble[0].lo == 0 && s_rumble[0].sent_ms == 0);
+    assert(s_host_state[0].buttons == 0);
+    assert(s_host_state[0].analog_lx == 128 && s_host_state[0].analog_ly == 128);
