diff --git a/libs/video/rsx_d3d12_depth_state.h b/libs/video/rsx_d3d12_depth_state.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_d3d12_depth_state.h
@@ -0,0 +1,19 @@
+/* RSX GL comparison enums to D3D12 values, independent of Windows. */
+#ifndef PS3RECOMP_RSX_D3D12_DEPTH_STATE_H
+#define PS3RECOMP_RSX_D3D12_DEPTH_STATE_H
+#include <stdint.h>
+static inline uint32_t rsx_d3d12_depth_key(int enabled, int writes, uint32_t compare)
+{
+    return (enabled ? 1u : 0u) | (writes ? 2u : 0u) | ((compare & 0xFFFFu) << 2);
+}
+static inline int rsx_d3d12_depth_writes(uint32_t key)
+{
+    return (key & 3u) == 3u;
+}
+static inline uint32_t rsx_d3d12_depth_comparison(uint32_t key)
+{
+    const uint32_t compare = key >> 2;
+    /* RSX NEVER..ALWAYS = 0x0200..0x0207; D3D12 = 1..8. */
+    return compare >= 0x0200u && compare <= 0x0207u ? compare - 0x01FFu : 4u;
+}
+#endif
diff --git a/tests/test_d3d12_depth_state.c b/tests/test_d3d12_depth_state.c
new file mode 100644
--- /dev/null
+++ b/tests/test_d3d12_depth_state.c
@@ -0,0 +1,24 @@
+#include "rsx_d3d12_depth_state.h"
+#include <stdio.h>
+#define CHECK(e) do { if (!(e)) { fprintf(stderr, "line %d: %s\n", __LINE__, #e); return 1; } } while (0)
+int main(void)
+{
+    for (uint32_t compare = 0x0200u; compare <= 0x0207u; ++compare)
+        for (int enable = 0; enable <= 1; ++enable)
+            for (int write = 0; write <= 1; ++write) {
+                uint32_t key = rsx_d3d12_depth_key(enable, write, compare);
+                CHECK((key & 1u) == (uint32_t)enable);
+                CHECK(rsx_d3d12_depth_writes(key) == (enable && write));
+                CHECK(rsx_d3d12_depth_comparison(key) == compare - 0x01FFu);
+                CHECK((key >> 2) == compare);
+            }
+    /* UI with depth disabled must not write, even with an enabled write mask. */
+    CHECK(!rsx_d3d12_depth_writes(rsx_d3d12_depth_key(0, 1, 0x0203u)));
+    CHECK(rsx_d3d12_depth_comparison(rsx_d3d12_depth_key(1, 1, 0x0207u)) == 8u);
+    CHECK(rsx_d3d12_depth_comparison(rsx_d3d12_depth_key(1, 0, 0x0201u)) == 2u);
+    CHECK(rsx_d3d12_depth_key(0, 1, 0x0203u) != rsx_d3d12_depth_key(1, 1, 0x0203u));
+    CHECK(rsx_d3d12_depth_key(1, 0, 0x0203u) != rsx_d3d12_depth_key(1, 1, 0x0203u));
+    CHECK(rsx_d3d12_depth_comparison(rsx_d3d12_depth_key(1, 1, 0u)) == 4u);
+    puts("D3D12 guest depth state: passed");
+    return 0;
+}
