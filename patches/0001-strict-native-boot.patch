+            nid, lr, (unsigned long long)ctx->thread_id,
+            (unsigned long long)arguments[0], (unsigned long long)arguments[1],
+            (unsigned long long)arguments[2], (unsigned long long)arguments[3],
+            (unsigned long long)ctx->gpr[3]);
