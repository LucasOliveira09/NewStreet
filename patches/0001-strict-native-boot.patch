+    const size_t length = strnlen(name, CELL_SAVEDATA_DIRNAME_SIZE);
+    if (!length || length == CELL_SAVEDATA_DIRNAME_SIZE || strchr(name, '/') ||
+        strchr(name, '\\') || !strcmp(name, ".") || !strcmp(name, ".."))
+        return CELL_SAVEDATA_ERROR_PARAM;
+    adopt_gamedata_root();
+    if (!dir_exists(s_save_root)) return CELL_SAVEDATA_ERROR_NOUSER;
+    char path[1024]; build_save_path(path, sizeof path, name);
+    if (!dir_has_save(path)) return CELL_SAVEDATA_ERROR_NODATA;
+    CellSaveDataSystemFileParam param;
+    if (!read_param_sfo(path, &param)) return CELL_SAVEDATA_ERROR_BROKEN;
+    HOST_STAT_T info;
+    if (HOST_STAT(path, &info) != 0) return CELL_SAVEDATA_ERROR_ACCESS_ERROR;
+    u64 rounded_kb;
+    if (enumerate_save_files(path, NULL, 0, &rounded_kb) == UINT32_MAX)
+        return CELL_SAVEDATA_ERROR_ACCESS_ERROR;
+    if (rounded_kb > UINT32_MAX - 35) return CELL_SAVEDATA_ERROR_SIZEOVER;
+    const u32 dir_ea = (u32)(uintptr_t)dir;
+    const u32 param_ea = (u32)(uintptr_t)sysFileParam;
+    if (dir_ea) {
+#ifdef _WIN32
+        vm_write64(dir_ea, (u64)info.st_atime);
+        vm_write64(dir_ea + 8, (u64)info.st_mtime);
+        vm_write64(dir_ea + 16, (u64)info.st_ctime);
+#elif defined(__APPLE__)
+        vm_write64(dir_ea, (u64)info.st_atimespec.tv_sec);
+        vm_write64(dir_ea + 8, (u64)info.st_mtimespec.tv_sec);
+        vm_write64(dir_ea + 16, (u64)info.st_ctimespec.tv_sec);
+#else
+        vm_write64(dir_ea, (u64)info.st_atim.tv_sec);
+        vm_write64(dir_ea + 8, (u64)info.st_mtim.tv_sec);
+        vm_write64(dir_ea + 16, (u64)info.st_ctim.tv_sec);
+#endif
+        memset(vm_base + dir_ea + 24, 0, CELL_SAVEDATA_DIRNAME_SIZE);
+        memcpy(vm_base + dir_ea + 24, name, length);
+    }
+    if (param_ea) {
+        memcpy(vm_base + param_ea, &param, 1552);
+        vm_write32(param_ea + 1280, param.attribute);
+    }
+    if (bind) vm_write32((u32)(uintptr_t)bind, 0); // Current local user owns this backend's save.
+    if (sizeKB) vm_write32((u32)(uintptr_t)sizeKB, (u32)rounded_kb + 35);
+    printf("[cellSaveData] GetListItem(dir='%s', sizeKB=%u)\n", name, (u32)rounded_kb + 35);
+    return CELL_OK;
+}
