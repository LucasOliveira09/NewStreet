@@ -0,0 +1,27 @@
+#ifndef RSX_TEXTURE_FINGERPRINT_H
+#define RSX_TEXTURE_FINGERPRINT_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+/* Process-local content fingerprint, never serialized. Read every source byte:
+ * sparse sampling can miss an entire glyph inserted between sampled columns.
+ * Word-at-a-time FNV-derived mixing avoids a multiply per individual texel;
+ * memcpy keeps unaligned source addresses valid, and the tail is not skipped. */
+static inline uint64_t rsx_texture_fingerprint(const void* data, size_t bytes)
+{
+    const uint8_t* source = (const uint8_t*)data;
+    uint64_t hash = UINT64_C(14695981039346656037) ^ (uint64_t)bytes;
+    size_t i = 0;
+    for (; bytes - i >= sizeof(uint64_t); i += sizeof(uint64_t)) {
+        uint64_t word;
+        memcpy(&word, source + i, sizeof word);
+        hash = (hash ^ word) * UINT64_C(1099511628211);
+    }
+    for (; i < bytes; ++i)
+        hash = (hash ^ source[i]) * UINT64_C(1099511628211);
+    return hash;
+}
+
+#endif
