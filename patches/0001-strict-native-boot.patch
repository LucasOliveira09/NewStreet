@@ -0,0 +1,161 @@
+/* TRP layout and version >=2 SHA-1: RPCS3 aa9ebd2f Loader/TRP.{h,cpp}.
+ * Installation uses original files, staged as a complete directory. Existing
+ * installations are verified byte for byte and never overwritten on mismatch. */
+#include "trophy_archive.h"
+#include "ps3emu/nid.h"
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+extern "C" const char* ppu_vfs_root;
+namespace {
+namespace fs = std::filesystem;
+constexpr uint32_t invalid = 0x8002290b, missing = 0x8002291b;
+constexpr uint32_t io = 0x8002291a, broken = 0x8002291e, checksum = 0x8002291f;
+struct Failure { uint32_t code; };
+struct Entry { std::string name; uint64_t offset, size; };
+uint64_t be(const uint8_t* p, unsigned n) {
+    uint64_t value = 0;
+    while (n--) value = (value << 8) | *p++;
+    return value;
+}
+std::vector<uint8_t> read(const fs::path& path, bool source = false) {
+    std::error_code error;
+    const auto size = fs::file_size(path, error);
+    if (error) throw Failure{source && error == std::errc::no_such_file_or_directory ? missing : io};
+    if (size > 64 * 1024 * 1024) throw Failure{invalid};
+    std::ifstream file(path, std::ios::binary);
+    std::vector<uint8_t> bytes((size_t)size);
+    if (!file || (size && !file.read((char*)bytes.data(), size))) throw Failure{io};
+    return bytes;
+}
+bool safe_name(const std::string& name) {
+    if (name.empty() || name[0] == '.' || name.size() > 31) return false;
+    return std::all_of(name.begin(), name.end(), [](unsigned char c) {
+        return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+               (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.';
+    });
+}
+std::string folded(std::string name) {
+    for (char& c : name) if (c >= 'a' && c <= 'z') c -= 'a' - 'A';
+    return name;
+}
+std::vector<Entry> parse(std::vector<uint8_t>& bytes) {
+    if (bytes.size() < 64 || be(bytes.data(), 4) != 0xdca24d00) throw Failure{invalid};
+    const auto version = be(bytes.data() + 4, 4), count = be(bytes.data() + 16, 4);
+    if (version < 1 || version > 3 || be(bytes.data() + 8, 8) != bytes.size() ||
+        !count || count > 512 || be(bytes.data() + 20, 4) != 64 ||
+        64 + count * 64 > bytes.size()) throw Failure{invalid};
+    if (version >= 2) {
+        std::array<uint8_t, 20> expected{}, actual{};
+        std::copy_n(bytes.data() + 28, 20, expected.data());
+        std::fill_n(bytes.data() + 28, 20, 0);
+        ps3_sha1_ctx hash; ps3_sha1_init(&hash);
+        ps3_sha1_update(&hash, bytes.data(), bytes.size());
+        ps3_sha1_final(&hash, actual.data());
+        std::copy(expected.begin(), expected.end(), bytes.data() + 28);
+        if (actual != expected) throw Failure{checksum};
+    }
+    std::vector<Entry> entries;
+    for (unsigned i = 0; i < count; ++i) {
+        const uint8_t* record = bytes.data() + 64 + i * 64;
+        const char* name = (const char*)record;
+        const char* end = (const char*)memchr(name, 0, 32);
+        if (!end) throw Failure{invalid};
+        Entry entry{std::string(name, end), be(record + 32, 8), be(record + 40, 8)};
+        if (!safe_name(entry.name) || entry.offset < 64 + count * 64 ||
+            entry.offset > bytes.size() || entry.size > bytes.size() - entry.offset)
+            throw Failure{invalid};
+        for (const auto& previous : entries) {
+            if (folded(entry.name) == folded(previous.name) ||
+                (entry.size && previous.size && entry.offset < previous.offset + previous.size &&
+                 previous.offset < entry.offset + entry.size)) throw Failure{invalid};
+        }
+        entries.push_back(entry);
+    }
+    // TROP.SFM is the archive's default-language configuration. Keep optional
+    // localized SFM files available; replace only the base, non-localized config.
+    auto default_config = std::find_if(entries.begin(), entries.end(),
+        [](const Entry& e) { return e.name == "TROP.SFM"; });
+    if (default_config != entries.end()) {
+        Entry chosen = *default_config; chosen.name = "TROPCONF.SFM";
+        std::erase_if(entries, [](const Entry& e) { return e.name == "TROPCONF.SFM" || e.name == "TROP.SFM"; });
+        entries.push_back(chosen);
+    }
+    if (std::none_of(entries.begin(), entries.end(), [](const Entry& e) { return e.name == "TROPCONF.SFM"; }))
+        throw Failure{invalid};
+    return entries;
+}
+bool installed(const fs::path& destination, const std::vector<Entry>& entries,
+               const std::vector<uint8_t>& bytes) {
+    if (!fs::exists(destination)) return false;
+    if (!fs::is_directory(destination) || fs::is_symlink(destination)) throw Failure{broken};
+    for (const Entry& entry : entries) {
+        const fs::path path = destination / entry.name;
+        if (fs::is_symlink(path) || !fs::is_regular_file(path)) throw Failure{broken};
+        const auto actual = read(path);
+        if (actual.size() != entry.size ||
+            !std::equal(actual.begin(), actual.end(), bytes.begin() + entry.offset)) throw Failure{broken};
+    }
+    return true;
+}
+}
+
+extern "C" uint32_t ps3_trophy_archive(const char* id, unsigned number, const char* storage,
+                                      int install, uint64_t* required) {
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    try {
+        if (!id || !storage || !required || std::strlen(id) != 9 || !safe_name(id) || number > 99)
+            return 0x80022906;
+        char suffix[4]; std::snprintf(suffix, sizeof suffix, "_%02u", number);
+        const std::string name = std::string(id) + suffix;
+        const fs::path root = ppu_vfs_root ? ppu_vfs_root : ".";
+        fs::path source = root / "PS3_GAME" / "TROPDIR" / name / "TROPHY.TRP";
+        if (!fs::exists(source)) source = root / "TROPDIR" / name / "TROPHY.TRP";
+        auto bytes = read(source, true);
+        const auto entries = parse(bytes);
+        const fs::path destination = fs::path(storage) / name;
+        if (installed(destination, entries, bytes)) { *required = 0; return 0; }
+        const uint64_t space = bytes.size() - 64 - be(bytes.data() + 16, 4) * 64;
+        if (!install) { *required = space; return 0; }
+        fs::create_directories(storage);
+        if (fs::space(storage).available < space) return 0x80022928;
+        static unsigned counter = 0;
+        fs::path staging;
+        bool created = false;
+        for (unsigned attempt = 0; attempt < 100 && !created; ++attempt) {
+            staging = fs::path(storage) / (name + ".install-" + std::to_string(++counter));
+            created = fs::create_directory(staging);
+        }
+        if (!created) return io;
+        try {
+            for (const Entry& entry : entries) {
+                std::ofstream file(staging / entry.name, std::ios::binary | std::ios::trunc);
+                file.write((const char*)bytes.data() + entry.offset, entry.size);
+                file.close();
+                if (!file) throw Failure{io};
+            }
+            if (!installed(staging, entries, bytes)) throw Failure{io};
+            fs::rename(staging, destination);
+        } catch (...) {
+            // Only remove entries from the directory just created by this call.
+            // No recursive removal and no mutation of an existing installation.
+            std::error_code ignored;
+            for (const Entry& entry : entries) fs::remove(staging / entry.name, ignored);
+            fs::remove(staging, ignored);
+            throw;
+        }
+        *required = 0;
+        return 0;
+    } catch (const Failure& failure) { return failure.code; }
+      catch (const fs::filesystem_error&) { return io; }
+      catch (const std::bad_alloc&) { return 0x80022905; }
+}
