+/* PAD_REPORT_TRACE observes only valid reports, after guest-memory stores.
+ * It answers whether a queued button reached a packet and which port/EA/mode
+ * received it. Each run's log directory supplies the correlation boundary.
+ * Default off, bounded to 64 state transitions, no guest-state changes. */
+static void pad_trace_report(u32 port, u32 guest_ea, const CellPadData* data)
+{
+    static atomic_int enabled = -1;
+    static atomic_uint previous[PAD_MAX_HOST_PORTS];
+    static atomic_uint count;
+    int trace = atomic_load_explicit(&enabled, memory_order_relaxed);
+    if (trace < 0) {
+        trace = getenv("PAD_REPORT_TRACE") ? 1 : 0;
+        atomic_store_explicit(&enabled, trace, memory_order_relaxed);
+    }
+    if (!trace || port >= PAD_MAX_HOST_PORTS || data->len <= 0) return;
+    u32 digital1 = data->button[CELL_PAD_BTN_OFFSET_DIGITAL1];
+    u32 digital2 = data->button[CELL_PAD_BTN_OFFSET_DIGITAL2];
+    u32 state = digital1 | (digital2 << 16);
+    if (atomic_exchange_explicit(&previous[port], state, memory_order_relaxed) == state) return;
+    unsigned sequence = atomic_fetch_add_explicit(&count, 1, memory_order_relaxed);
+    if (sequence >= 64) return;
+    fprintf(stderr, "[pad-report] {\"sequence\":%u,\"port\":%u,\"guest_address\":%u,\"length\":%d,\"mode\":%u,\"digital1\":%u,\"digital2\":%u}\n",
+        sequence, port, guest_ea, data->len, data->button[1], digital1, digital2);
+}
