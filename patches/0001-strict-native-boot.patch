+/* Optional bounded trace of first import/caller pairs. Unlike the boot-only
+ * call counter this still observes rare storage calls after polling starts.
+ * The lock protects admission only; it is never held while guest/HLE code runs. */
+struct HleFirstCallTrace {
+    ppu_context* ctx;
+    uint32_t nid, lr;
+    uint64_t arguments[4]{};
+    bool admitted = false;
+    HleFirstCallTrace(uint32_t id, ppu_context* context)
+        : ctx(context), nid(id), lr((uint32_t)context->lr) {
+        static const bool enabled = getenv("PS3_HLE_FIRST_CALLS") != nullptr;
+        if (!enabled) return;
+        static std::mutex mutex;
+        static uint64_t keys[4096]{};
+        static unsigned count = 0;
+        const uint64_t key = (uint64_t(nid) << 32) | lr;
+        std::lock_guard<std::mutex> lock(mutex);
+        for (unsigned i = 0; i < count; ++i) if (keys[i] == key) return;
+        if (count == 4096) return;
