+static int hlsl_replace_range(char* hlsl, size_t cap, char* begin, char* end,
+                              const char* replacement)
+{
+    if (!hlsl || !begin || !end || end < begin) return 0;
+    size_t prefix = (size_t)(begin - hlsl), old_len = (size_t)(end - begin);
+    size_t new_len = strlen(replacement), tail_len = strlen(end);
+    if (prefix + new_len + tail_len >= cap) return 0;
+    memmove(begin + new_len, end, tail_len + 1);
+    memcpy(begin, replacement, new_len);
+    return 1;
 }
 
