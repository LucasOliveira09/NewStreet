diff --git a/runtime/spu/spu_channels.c b/runtime/spu/spu_channels.c
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -936,6 +936,19 @@ void spu_wrch(spu_context* ctx, uint32_t channel, u128 value)
         break;
     }
 }
+
+/* A lifted basic block may execute many guest instructions before updating
+ * ctx->pc. Supply the exact WRCH address around an MFC_Cmd callback so DMA
+ * diagnostics attribute synchronous transfers to the instruction that issued
+ * them. Restore the block PC afterward; an architectural stop/longjmp does not
+ * return here and correctly retains the issuing PC. */
+void spu_wrch_at(spu_context* ctx, uint32_t guest_pc, uint32_t channel, u128 value)
+{
+    uint32_t saved_pc = ctx->pc;
+    ctx->pc = guest_pc & SPU_LS_MASK;
+    spu_wrch(ctx, channel, value);
+    ctx->pc = saved_pc;
+}

